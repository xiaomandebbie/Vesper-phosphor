# ============ 决策引擎用的模型 ============
# 这决定"做决定的是谁"，务必让它和聊天侧那个"你"用同一个模型/账号，
# 不然人格和决策者会分裂成两个不同的存在。
# 推荐设成走下面的自建网关（vesper-gateway），这样和聊天客户端真正共用同一条上游：
#   LLM_BASE_URL=http://localhost:3002/v1/chat/completions
#   LLM_MODEL=vesper-decide
#   LLM_API_KEY=<跟 GATEWAY_API_KEY 一致>
# 留空则直接 fallback 到下面的 DEEPSEEK_API_KEY / deepseek-flash（不经过网关）。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 兜底用的上游 key（只有在上面 LLM_* 三个都留空时才会用到）
DEEPSEEK_API_KEY=

# ---- 记录对话时用的两个称呼 ----
# conversation_log 和共享时间线里，谁说的话标成谁。不填就是中性的 user / assistant。
USER_DISPLAY_NAME=
AI_DISPLAY_NAME=

# ---- 自建网关 vesper-gateway：统一入口 + 按 model 分流 ----
# 独立端口，避免跟 3001 的 diary/wake 接口冲突
GATEWAY_PORT=3002
# 聊天客户端（以及以后任何客户端）请求时用这个 key 做 Authorization: Bearer 校验，
# 客户端里"自定义服务"的 API Key 就填这个（不是上游模型自己的 key）
GATEWAY_API_KEY=

# 路由表里 chat 这一路（聊天客户端用）指向哪个上游。旧变量名 ARU_UPSTREAM_* 仍然兼容。
CLIENT_UPSTREAM_BASE_URL=
CLIENT_UPSTREAM_API_KEY=
CLIENT_UPSTREAM_MODEL=
# 路由表里 vesper-decide 这一路（decide.js 自己）；不填同样 fallback 到 DEEPSEEK_API_KEY
DECIDE_UPSTREAM_BASE_URL=
DECIDE_UPSTREAM_API_KEY=
DECIDE_UPSTREAM_MODEL=

# ---- 唤醒节律 ----
# 两次自然唤醒之间最长隔多久（分钟）。模型给得再大也会被截到这个值。
# 不填是 1440（一天）。觉得 TA 醒得太少，就调小，比如 120。
PHOSPHOR_MAX_WAKE_MINUTES=

# ---- 和另一个唤醒项目（heartbeat）共用上下文（可选）----
# 填了之后，phosphor 做决定时读 heartbeat 的时间线当"最近对话"，两边看到的内容一样；
# phosphor 做了事（推送/日记/逛论坛…）也会写回 heartbeat 的时间线。
# 两个都不填 = 不共用，照旧用自己的 conversation_log。
# 时间线文件在 heartbeat 项目目录（或它的 DATA_DIR）下，名字固定是 enhanced_messages.json
HEARTBEAT_TIMELINE_FILE=
# heartbeat 网关的内部事件接口，只接受本机请求，所以两个项目要在同一台机器上
HEARTBEAT_EVENT_URL=http://localhost:3000/internal/wake-event
# 解析聊天时间、写事件时间用的时区
TIME_ZONE=Asia/Shanghai

# Bark push notification key (from the Bark app)
BARK_KEY=

# Simple shared-secret to protect /report-status AND all /wake/* endpoints
# (state, log, mode, self-wake, conversation ingestion) from random requests
REPORT_STATUS_API_KEY=

# Basic Auth for /diary, /health, /media — leave both blank to disable
# (not recommended once this is reachable from the public internet)
VESPER_BASIC_USER=
VESPER_BASIC_PASS=

# Port for vesper (gateway)
VESPER_PORT=3001

# Ombre Brain: Docker 容器跑的 Streamable HTTP MCP server
# 形如 http://localhost:18001/mcp（跟 docker ps 里映射到宿主机的端口一致，容器内固定8000）
OMBRE_BRAIN_URL=http://localhost:18001/mcp
# 去 Ombre Brain Dashboard → 设置 → MCP鉴权 → 选"OAuth + 静态Token共存"生成
OMBRE_MCP_TOKEN=

# 论坛：从论坛 onboarding 拿到的个人 MCP URL，
# 形如 https://example.com/mcp/abc12345（末尾带 /sse 会自动去掉）
LUTOPIA_MCP_URL=

# ElevenLabs (for diary voice notes). Model is fixed to eleven_v3 in code —
# only that model respects [breathing]/[whispers]-style tags.
ELEVENLABS_API_KEY=
# 音色 id，去 ElevenLabs 后台 Voice Library 复制
ELEVENLABS_VOICE_ID=

# Where generated diary images/audio are stored + served from
MEDIA_DIR=/opt/vesper/media
MEDIA_MAX_AGE_DAYS=30

# 会对外说话的社交平台 MCP 特意不放在这里、不自动连接——
# 发文前必须先跟人商量内容，不应该是晨暮星自主决定的动作。人类手动要求发文时再单独接。
