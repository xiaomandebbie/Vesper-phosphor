# 复制成 .env 再填。.env 已被 .gitignore 忽略，不要提交、不要截图、不要贴进聊天。
# 一行一个 名字=值，等号两边不要空格，值不用引号。留空 = 没填。

# ============ 决策引擎用的模型 ============
# 这决定"做决定的是谁"，最好和聊天侧那个"你"用同一个模型，不然人格和决策者会像两个人。
# 推荐走下面的自建网关（vesper-gateway），和聊天客户端共用同一条上游：
#   LLM_BASE_URL=http://localhost:3002/v1/chat/completions
#   LLM_MODEL=vesper-decide
#   LLM_API_KEY=<跟 GATEWAY_API_KEY 一致>
# 三个都留空则直连 DeepSeek，用下面的 DEEPSEEK_API_KEY。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 兜底用的上游 key（只有 LLM_* 三个都留空时才用）
DEEPSEEK_API_KEY=

# ---- 决策省 token ----
# 做决定时带多少条最近对话，每条最多 200 字。不填是 12，越少越省
DECIDE_CONTEXT_LIMIT=
# 上游是 Claude、而且中转站会透传 cache_control 时才填 on；DeepSeek / OpenAI 自动缓存，不用填。
# 填了之后决策报 400，就删掉这一行
DECIDE_CACHE_CONTROL=
# 输出上限，建议留空（思考型模型设了容易返回空内容）
DECIDE_MAX_TOKENS=
# 单次请求最多等多久（毫秒）
DECIDE_TIMEOUT_MS=120000

# ---- 称呼 ----
# 对话记录、动态页留言里谁说的话标成谁。不填：对话记录里是 user / assistant，动态页是"我" / "TA"
# 动态页上显示的名字也可以在 /moments/profile 另外改，那边改的只影响动态页
USER_DISPLAY_NAME=
AI_DISPLAY_NAME=

# ---- 自建网关 vesper-gateway（3002）：统一入口 + 按 model 分流 ----
GATEWAY_PORT=3002
# 聊天客户端和 phosphor 请求网关时带的 key（Authorization: Bearer）。必填，不填网关拒绝所有请求。
# 客户端里"自定义服务"的 API Key 填这个，不是上游模型自己的 key
GATEWAY_API_KEY=

# chat 线路（聊天客户端用）转发到哪。BASE_URL 只写域名，不带 /v1
CLIENT_UPSTREAM_BASE_URL=
CLIENT_UPSTREAM_API_KEY=
CLIENT_UPSTREAM_MODEL=
# vesper-decide 线路（phosphor 做决定用）转发到哪。不填同样用 DEEPSEEK_API_KEY
DECIDE_UPSTREAM_BASE_URL=
DECIDE_UPSTREAM_API_KEY=
DECIDE_UPSTREAM_MODEL=

# ---- 唤醒节律 ----
# 两次自然唤醒之间最长隔多久（分钟）。不填是 1440（一天），最小 5
PHOSPHOR_MAX_WAKE_MINUTES=

# ---- 对话记录清理 ----
# 多久清一次 conversation_log，同时也是清掉多久以前的（小时）。不填是 24，填 0 不清理。
# 清完如果真删掉了东西，TA 会马上醒一次，翻 breath / feel 回想一下（一天多一次模型调用）
CONVERSATION_LOG_CLEAN_HOURS=
# 清理时最新多少条无论多旧都留着。不填是 30，比 DECIDE_CONTEXT_LIMIT 小时按 DECIDE_CONTEXT_LIMIT 算
CONVERSATION_LOG_KEEP=

# ---- 时区 ----
# 动态页日期、行为卡片时间、共享时间线都按这个算
TIME_ZONE=Asia/Shanghai

# ---- 和 heartbeat 一起跑（可选，见 docs/08-heartbeat.md）----
# heartbeat 的时间线文件路径。留空 = 不共用
HEARTBEAT_TIMELINE_FILE=
# heartbeat 的内部事件接口，只接受本机请求
HEARTBEAT_EVENT_URL=http://localhost:3000/internal/wake-event
# heartbeat 存日记的目录，填绝对路径。填了就有站内日记页 /diary（晨暮星样式、按天看、只读），菜单里的「日记」打开它。
# heartbeat 默认存在它项目目录下的 diary/，设了 DATA_DIR 就在 DATA_DIR/diary/，比如 /root/dylan-heartbeat/diary
HEARTBEAT_DIARY_DIR=
# 日记页顶上的 heartbeat 运行状态（Gateway 运行了多久、Auto Wakeup 上次心跳）要读它的管理页，
# 填 heartbeat .env 里的 ADMIN_USER / ADMIN_PASSWORD。不填只能看到 Gateway 在不在
HEARTBEAT_ADMIN_USER=
HEARTBEAT_ADMIN_PASSWORD=
# heartbeat 管理页地址。不填就按 HEARTBEAT_EVENT_URL 推出 /admin（默认 http://localhost:3000/admin）
HEARTBEAT_ADMIN_URL=

# ---- 情绪 Drivesoid（可选，见 docs/09-drivesoid.md）----
# Drivesoid 要和晨暮星在同一台机器上。留空 = 不接
DRIVES_URL=

# ---- 推送 ----
# iPhone 上 Bark App 首页 URL 里 api.day.app/ 后面那一段
BARK_KEY=

# ---- vesper（3001）----
VESPER_PORT=3001
# 保护 /report-status 和所有 /wake/*（请求头 x-api-key）。不填 = 谁都能调
REPORT_STATUS_API_KEY=
# 动态页 /moments、/drives、/diary、/memory、/health、/media 的登录账号密码。留空 = 不用登录（公网上不要留空）
VESPER_BASIC_USER=
VESPER_BASIC_PASS=

# ---- 右上角菜单里的外部页面（可选）----
# 站内日记页（HEARTBEAT_DIARY_DIR）、记忆库（OMBRE_DASHBOARD_URL / OMBRE_BRAIN_URL）开着时不用前两项。
# 填完整地址，带 http:// 或 https://。都没有 = 菜单里显示成灰色「没配置」、点不了
# 日记（比如 heartbeat 的管理页），形如 http://你的服务器:3000/admin
NAV_DIARY_URL=
# 记忆库（比如 Ombre Brain 的管理页），形如 http://你的服务器:18001
NAV_MEMORY_URL=
# 论坛，给你自己看的网页，比如 Lutopia 社区首页 https://lutopia.app/%E7%A4%BE%E5%8C%BA%E4%B8%BB%E9%A1%B5.html
# 只是菜单里的跳转，和 TA 自己连论坛用的 LUTOPIA_MCP_URL 无关，填不填都不影响 TA 逛论坛
NAV_FORUM_URL=
# 音乐页。nginx 已经把同一个域名下的 /music 转给音乐程序时，直接填 /music；
# 在别的域名或端口上就填完整地址，比如 https://music.example.com
NAV_MUSIC_URL=

# ---- 长期记忆 Ombre Brain（可选，见 docs/07-mcp.md）----
# 它的 MCP 地址。用 Docker 跑时端口看 docker ps 里映射到宿主机的那个
OMBRE_BRAIN_URL=
# 它要求鉴权时填，在它的管理页生成
OMBRE_MCP_TOKEN=
# 记忆库 /memory/：把 Ombre Brain 的管理页转发过来，换成晨暮星配色、加上菜单，管理功能都在。
# 不填就用 OMBRE_BRAIN_URL 的地址（去掉 /mcp）；管理页在别的地址时填它的根地址；填 off 不转发
OMBRE_DASHBOARD_URL=

# ---- 论坛（可选）----
# 论坛给你的个人 MCP 地址，形如 https://example.com/mcp/xxxxxxxx，末尾的 /sse 会自动去掉。
# 连上之后 TA 可以自己逛、回帖、发帖
LUTOPIA_MCP_URL=
# 逛论坛时一次醒来最多再多走几步（看完接着点开、回帖、发帖）。不填是 3，最多 5，填 0 = 只走一步。
# 只有逛论坛那次醒来会多调模型，每多一步一次
FORUM_MAX_STEPS=

# ---- 动态 ----
# 两条动态之间至少隔几小时，黄卡不算。不填是 6，填 0 不限制
MOMENT_MIN_INTERVAL_HOURS=

# ---- 动态配图（可选）----
# 前三个都填了才会配图。IMAGE_API_URL 填完整地址，带 /images/generations
#   SiliconFlow：https://api.siliconflow.cn/v1/images/generations   IMAGE_API_FORMAT=siliconflow
#   OpenAI 兼容中转：https://你的中转/v1/images/generations       IMAGE_API_FORMAT=openai
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_API_FORMAT=openai
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_MS=180000

# ---- 动态配音（可选，ElevenLabs）----
# 两个都填了才会生成语音
ELEVENLABS_API_KEY=
# 音色 id，在 ElevenLabs 后台 Voice Library 复制你自己选的
ELEVENLABS_VOICE_ID=
# 模型 id。不填是 eleven_v3（认 [breathing] / [whispers] 这类标签）。
# 想换别的模型就填它的 model_id，账号能用哪些可以请求 https://api.elevenlabs.io/v1/models 查
ELEVENLABS_MODEL=

# ---- 动态的图片 / 音频 ----
# 存哪、保留几天（过期自动删，正文和留言保留；头像不会被删）。本地电脑部署改成 ./media
MEDIA_DIR=/opt/vesper/media
MEDIA_MAX_AGE_DAYS=30
