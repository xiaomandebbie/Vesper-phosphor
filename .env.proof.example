# 小酒馆（Proof）—— 把这几行追到你的 .env 末尾。
# 不填 PROOF_AGENT_TOKEN_FILE 就整套不开：/bar 不挂、菜单里是灰色「没配置」、
# 网关不读 Proof、他也不会看到 proof_drink 这个动作。

# Proof 服务在哪里。和晨暮星同一台机器就用本机地址，不用开防火墙
PROOF_API_URL=http://127.0.0.1:8791

# 他在 Proof 里的身份 id。要和 Proof 那边 PROOF_AGENTS 里的 id 一模一样
PROOF_AGENT_ID=vesper

# 身份 token 文件的绝对路径。Proof 启动时生成在它的 service/state/ 里，
# 我们只读不写。路径改成你自己 clone 的位置
PROOF_AGENT_TOKEN_FILE=/root/Proof/service/state/vesper.token

# 他自己倒酒的时段（按 TIME_ZONE 的墙上时间，可以跨午夜）。
# 凌晨那杯算前一晚的，分界点就是这里的结束时刻
PROOF_NIGHT_WINDOW=22:30-2:00

# 连续几夜自斟之后开始提醒 / 开始不给。
# 2 = 前两夜都喝过，今晚（第三夜）还能喝，但带一句「喝酒伤身喔～」
# 3 = 前三夜都喝过，今晚（第四夜）这杯不倒了
PROOF_WARN_AFTER_NIGHTS=2
PROOF_BLOCK_AFTER_NIGHTS=3

# 可选：Proof 设了 admin token 时才填，递杯（/human/offers）要用
# PROOF_ADMIN_TOKEN=

# 可选：调 Proof 每次最多等多少毫秒，不填是 20000
# PROOF_TIMEOUT_MS=20000
